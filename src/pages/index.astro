---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import FutureLink from "../components/FutureLink.astro";
import PlanFrame from "../components/PlanFrame.astro";
import Icon from "../components/Icon.astro";
import "../styles/site.css";
import k76 from "../assets/img/k-76.jpg";
import plan1200 from "../assets/img/plan-1200.webp";
import plan2400 from "../assets/img/plan-2400.webp";
import {
  TEL, PHONE_SHOWN, VIBER, TELEGRAM, WHATSAPP, MAILTO, EMAIL, MAPS, INSTAGRAM, FACEBOOK, SOON, PHONE,
  wa, projectsLead, projectsMore, houses, prices,
} from "../data/site";

const title = "Будинок під ключ у Вишгородському районі — Лайфбуд";
const description = "Будинки під ключ у Вишгородському районі: виконані проєкти «Лайфбуд», ціни від 550 у.о./м², КМ «Сонячний» за 12 км від Києва. Телефон і Viber.";

const housesLead = houses.slice(0, 6);
const housesMore = houses.slice(6);
const maxPrice = Math.max(...prices.map((p) => p.value));
// mosaic rhythm 7/5, 5/7, 7/5 (concept.md §5.1)
const span = (i: number) => ((Math.floor(i / 2) % 2 === 0) === (i % 2 === 0) ? "tile--wide" : "tile--narrow");

const ld = {
  "@context": "https://schema.org",
  "@type": ["Organization", "HomeAndConstructionBusiness"],
  name: "Лайфбуд",
  telephone: PHONE,
  email: EMAIL,
  areaServed: "Вишгородський район, Київська область",
  address: { "@type": "PostalAddress", streetAddress: "КМ «Сонячний», вул. Садова", addressRegion: "Київська область", addressCountry: "UA" },
  geo: { "@type": "GeoCoordinates", latitude: 50.581375, longitude: 30.558641 },
  sameAs: [INSTAGRAM, FACEBOOK],
};
---
<Base lang="uk" title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2D2D2D" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>
  <Header slot="header" />

  <!-- 1. hero -->
  <Section id="hero" class="hero" rec="R-008">
    <div class="hero__field">
      <div class="container hero__text">
        <h1 data-rec="R-014,SEO-R006">Будинок під ключ <span class="hero__h1-2">у&nbsp;Вишгородському районі</span></h1>
        <div class="hero__row">
          <p class="hero__lead">Будинки в КМ «Сонячний» — 12 км від Києва, 5 км від Вишгорода. Будівництво та продаж від «Лайфбуд».</p>
          <div class="hero__actions">
            <details class="talk" data-rec="R-008,G-R003">
              <summary class="btn btn--dark talk__btn">Обговорити свій будинок <Icon name="plus" class="talk__plus" /></summary>
              <ul class="talk__list">
                <li><a class="btn btn--dark" href={TEL}><Icon name="phone" />Подзвонити</a></li>
                <li><a class="btn btn--line" href={VIBER}><Icon name="viber" />Viber</a></li>
                <li><a class="btn btn--line" href={TELEGRAM}><Icon name="telegram" />Telegram</a></li>
              </ul>
            </details>
            <div class="hero__links">
              <a class="text-link" href="#projects">Обрати проєкт</a>
              <a class="text-link" href="#houses">Будинки в КМ «Сонячний» і генплан</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero__stage">
      <div class="container">
        <figure class="hero__photo">
          <Image
            src={k76}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1440px) 1312px, calc(100vw - 2 * var(--space))"
            format="webp"
            quality={78}
            alt="Проєкт К-76, 134 м², збудований будинок"
            loading="eager"
            fetchpriority="high"
            data-rec="R-001,R-003,R-004"
          />
          <figcaption class="plate">
            <span class="plate__code">Проєкт К-76</span>
            <span class="plate__meta">134 м², 3 спальні</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <!-- 2. projects -->
  <Section id="projects" class="section projects" rec="R-010">
    <div class="container">
      <div class="section__head">
        <h2>Виконані проєкти: від 108 до 229 м²</h2>
        <p class="lead muted">Кожен будинок має свій код. Назвіть його в месенджері, і ми розповімо про проєкт.</p>
      </div>

      <ul class="mosaic" role="list">
        {projectsLead.map((p, i) => (
          <li class:list={["tile", span(i)]}>
            <figure class="tile__photo">
              <Image src={p.img} widths={[480, 720, 960]} sizes="(min-width: 1024px) 58vw, (min-width: 768px) 50vw, 100vw" format="webp" quality={76} alt={`Проєкт ${p.code}${p.area ? `, ${p.area} м²` : ""}`} loading="lazy" data-rec="R-003,R-004" />
            </figure>
            <div class="tile__body">
              <h3 class="tile__code">{p.code}</h3>
              <p class="tile__meta">{p.area && <span>{p.area} м²</span>}<span>{p.bedrooms} спальні</span></p>
              <a class="btn btn--line tile__ask" href={wa(`Добрий день! Цікавить проєкт ${p.code}`)}>Обговорити такий проєкт <Icon name="arrow" class="icon--move" /></a>
            </div>
          </li>
        ))}
      </ul>

      <details class="more">
        <summary class="btn btn--dark more__btn">Показати ще {projectsMore.length}</summary>
        <ul class="compact" role="list">
          {projectsMore.map((p) => (
            <li class="ctile">
              <figure class="tile__photo">
                <Image src={p.img} widths={[360, 700]} sizes="(min-width: 1024px) 25vw, 50vw" format="webp" quality={74} alt={`Проєкт ${p.code}${p.area ? `, ${p.area} м²` : ""}`} loading="lazy" data-rec="R-003,R-004" />
              </figure>
              <h3 class="ctile__code">{p.code}</h3>
              <p class="tile__meta">{p.area && <span>{p.area} м²</span>}<span>{p.bedrooms} спальні</span></p>
              <a class="text-link ctile__ask" href={wa(`Добрий день! Цікавить проєкт ${p.code}`)}>Обговорити</a>
            </li>
          ))}
        </ul>
      </details>
      <p class="projects__all"><FutureLink note={SOON} class="fl-quiet">Усі проєкти</FutureLink></p>
    </div>
  </Section>

  <!-- 3. build -->
  <Section id="build" class="section build" rec="R-010">
    <div class="container build__grid">
      <div class="build__text">
        <h2>Будівництво під ключ — від&nbsp;550&nbsp;у.о. за м²</h2>
        <div class="stages">
          <p><strong>Проєкт.</strong> Готові проєкти будинків — компроміс між вашими бажаннями, часом і вартістю проєктування. Проєкти редагуються з урахуванням вимог замовника.</p>
          <p><strong>Матеріали.</strong> Якщо ви ще не вирішили, з чого будувати, безкоштовно проконсультуємо і розкажемо про плюси та мінуси кожного матеріалу.</p>
          <p><strong>Будівництво.</strong> «Лайфбуд» спеціалізується на будівництві будинків і котеджів у Вишгородському районі.</p>
        </div>
      </div>
      <div class="build__prices">
        <ol class="prices" role="list" data-reveal>
          {prices.map((p, i) => (
            <li class="price" style={`--w:${Math.round((p.value / maxPrice) * 100)}%;--i:${i}`}>
              <p class="price__bar"><span class="price__from">від</span> <span class="price__num">{p.value}</span> <span class="price__unit">у.о./м²</span></p>
              <h3 class="price__title">{p.title}</h3>
              <p class="price__text">{p.text}</p>
            </li>
          ))}
        </ol>
        <a class="btn btn--dark build__cta" href={VIBER}><Icon name="viber" />Розрахувати вартість мого будинку</a>
      </div>
    </div>
  </Section>

  <!-- 4. houses -->
  <Section id="houses" class="section houses on-dark">
    <div class="container">
      <div class="section__head">
        <h2>Будинки в КМ «Сонячний», 12 км від Києва</h2>
        <p class="lead houses__note">Наявність і ціну уточнюйте — відповімо в месенджері або телефоном.</p>
        <a class="text-link" href="#build">Побудуємо за одним із цих проєктів</a>
      </div>
      <div class="houses__grid">
        <figure class="plan">
          <a class="plan__open" href={plan2400.src} data-plan-open aria-label="Відкрити генеральний план КМ «Сонячний» великим">
            <PlanFrame src={plan1200} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 560px, 100vw" class="plan__frame" />
          </a>
          <figcaption class="plan__cap">
            <span>Генеральний план КМ «Сонячний»</span>
            <a class="text-link" href={plan2400.src} data-plan-open><Icon name="map" />Відкрити генплан</a>
          </figcaption>
        </figure>

        <div class="houses__list">
          <ul class="hlist" role="list">
            {housesLead.map((h) => (
              <li class="dim" data-plot={h.plots.length ? h.slug : undefined}>
                <Image src={h.img} widths={[240, 480]} sizes="(min-width: 768px) 160px, 96px" format="webp" quality={72} alt={`Будинок ${h.code}`} class="house__img" loading="lazy" data-rec="R-003,R-004" />
                <div class="house__body">
                  <h3 class="house__code">{h.code}</h3>
                  {h.area && <p class="house__area">{h.area} м²</p>}
                  <div class="house__acts">
                    <a class="btn btn--outline-accent house__ask" href={wa(`Добрий день! Цікавить будинок ${h.code}`)}>Запитати про цей будинок</a>
                    {h.plots.length > 0 && <button type="button" class="house__plan" data-plan-show={h.slug} aria-label={`Показати ${h.code} на плані`}>Показати на плані</button>}
                  </div>
                </div>
              </li>
            ))}
          </ul>
          <details class="hmore">
            <summary class="btn btn--ghost-dark hmore__btn">Показати ще {housesMore.length}</summary>
            <ul class="hlist" role="list">
              {housesMore.map((h) => (
                <li class="dim" data-plot={h.plots.length ? h.slug : undefined}>
                  <Image src={h.img} widths={[240, 480]} sizes="(min-width: 768px) 160px, 96px" format="webp" quality={72} alt={`Будинок ${h.code}`} class="house__img" loading="lazy" data-rec="R-003,R-004" />
                  <div class="house__body">
                    <h3 class="house__code">{h.code}</h3>
                    {h.area && <p class="house__area">{h.area} м²</p>}
                    <div class="house__acts">
                      <a class="btn btn--outline-accent house__ask" href={wa(`Добрий день! Цікавить будинок ${h.code}`)}>Запитати про цей будинок</a>
                      {h.plots.length > 0 && <button type="button" class="house__plan" data-plan-show={h.slug} aria-label={`Показати ${h.code} на плані`}>Показати на плані</button>}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </div>

    <dialog class="plan-dialog on-dark" aria-label="Генеральний план КМ «Сонячний»">
      <div class="plan-dialog__bar">
        <p class="plan-dialog__title">Генеральний план КМ «Сонячний»</p>
        <button type="button" class="btn btn--ghost-dark plan-dialog__close" data-plan-close><Icon name="close" />Закрити</button>
      </div>
      <div class="plan-dialog__scroll">
        <PlanFrame src={plan2400} widths={[1200, 2400]} sizes="(min-width: 1200px) 1100px, 900px" class="plan-dialog__frame" />
      </div>
    </dialog>
  </Section>

  <!-- 5. about -->
  <Section id="about" class="section about">
    <div class="container">
      <div class="about__top">
        <h2>Про «Лайфбуд»</h2>
        <p class="about__statement">«Лайфбуд» проєктує і будує приватні будинки та котеджі у Вишгородському районі.</p>
      </div>
      <ul class="dirs" role="list">
        <li><h3><a href="#build">Будівництво під ключ</a></h3><p class="muted">Коробка, під оздоблення або під ключ, від 550 у.о. за м².</p></li>
        <li><h3><FutureLink note={SOON}>Проєктування</FutureLink></h3><p class="muted">Квартири, приватні будинки, дачі, офісні приміщення.</p></li>
        <li><h3><FutureLink note={SOON}>Оздоблення і реставрація</FutureLink></h3><p class="muted">Житлові й нежитлові приміщення, фасадні та внутрішні оздоблювальні роботи.</p></li>
        <li><h3><FutureLink note={SOON}>Оренда спецтехніки</FutureLink></h3><p class="muted">Умови оренди уточнюйте телефоном <a href={TEL}>{PHONE_SHOWN}</a>.</p></li>
      </ul>
      <p class="about__more"><FutureLink note={SOON} class="fl-quiet">Детальніше про компанію</FutureLink></p>
    </div>
  </Section>

  <!-- 6. contacts -->
  <Section id="contacts" class="section contacts on-dark" rec="R-012">
    <div class="container contacts__grid">
      <div class="contacts__main">
        <h2>Зв'язатися з «Лайфбуд»</h2>
        <a class="contacts__phone" href={TEL}>{PHONE_SHOWN}</a>
        <ul class="contacts__channels" role="list">
          <li><a class="btn btn--accent" href={VIBER}><Icon name="viber" />Viber</a></li>
          <li><a class="btn btn--ghost-dark" href={TELEGRAM}><Icon name="telegram" />Telegram</a></li>
          <li><a class="btn btn--ghost-dark" href={WHATSAPP}><Icon name="whatsapp" />WhatsApp</a></li>
          <li><a class="btn btn--ghost-dark" href={MAILTO}><Icon name="mail" />E-mail</a></li>
        </ul>
        <address class="contacts__addr">
          <Icon name="pin" />
          <span>КМ «Сонячний», вул. Садова, Вишгородський район, Київська область</span>
        </address>
        <p class="contacts__links">
          <a class="text-link" href={MAPS} target="_blank" rel="noopener noreferrer">Відкрити в Google Maps</a>
          <a class="text-link" href={INSTAGRAM} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a class="text-link" href={FACEBOOK} target="_blank" rel="noopener noreferrer">Facebook</a>
        </p>
      </div>

      <div class="lead-form" role="group" aria-labelledby="lead-title">
        <h3 id="lead-title" class="lead-form__title">Заявка на розмову про будинок</h3>
        <div class="field">
          <label for="lf-name">Ім'я</label>
          <input id="lf-name" name="name" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="lf-phone">Телефон</label>
          <input id="lf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+380" />
        </div>
        <div class="field">
          <label for="lf-topic">Що вас цікавить</label>
          <select id="lf-topic" name="topic">
            <option>Будівництво під ключ</option>
            <option>Будинок у КМ «Сонячний»</option>
            <option>Інше</option>
          </select>
        </div>
        <div class="lead-form__acts">
          <FutureLink note="Онлайн-заявка з'явиться в повній версії сайту" class="btn btn--off">Надіслати</FutureLink>
          <a class="btn btn--dark" href={TEL}><Icon name="phone" />Подзвонити</a>
          <a class="btn btn--line" href={VIBER}><Icon name="viber" />Написати у Viber</a>
        </div>
        <p class="lead-form__hint">Онлайн-заявка з'явиться в повній версії сайту. Зараз найшвидше — дзвінок або Viber.</p>
      </div>
    </div>
  </Section>

  <Footer slot="footer" />
  <MobileBar slot="footer" />
</Base>

<script>
  // Signature: a dim row highlights its plot on the plan (hover / focus); «Показати на плані» opens the big plan.
  const plots = (root: ParentNode, slug: string | null) =>
    root.querySelectorAll<HTMLElement>(".plot").forEach((p) => p.classList.toggle("is-on", !!slug && p.dataset.plot === slug));
  const section = document.querySelector<HTMLElement>("#houses");
  const dialog = document.querySelector<HTMLDialogElement>(".plan-dialog");
  const planInline = section?.querySelector<HTMLElement>(".plan");

  if (section) {
    section.querySelectorAll<HTMLElement>(".dim[data-plot]").forEach((row) => {
      const on = () => planInline && plots(planInline, row.dataset.plot ?? null);
      const off = () => planInline && plots(planInline, null);
      row.addEventListener("pointerenter", on);
      row.addEventListener("pointerleave", off);
      row.addEventListener("focusin", on);
      row.addEventListener("focusout", off);
    });
  }

  const openPlan = (slug: string | null) => {
    if (!dialog) return false;
    plots(dialog, slug);
    dialog.showModal();
    const target = slug ? dialog.querySelector<HTMLElement>(`.plot[data-plot="${slug}"]`) : null;
    requestAnimationFrame(() => target?.scrollIntoView({ block: "center", inline: "center" }));
    return true;
  };
  document.querySelectorAll<HTMLAnchorElement>("[data-plan-open]").forEach((a) =>
    a.addEventListener("click", (e) => { if (openPlan(null)) e.preventDefault(); }));
  document.querySelectorAll<HTMLButtonElement>("[data-plan-show]").forEach((b) =>
    b.addEventListener("click", () => openPlan(b.dataset.planShow ?? null)));
  dialog?.querySelector("[data-plan-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });

  // Desktop shows all 12 houses next to the plan; phones keep 6 + «Показати ще».
  const hmore = document.querySelector<HTMLDetailsElement>(".hmore");
  const wide = window.matchMedia("(min-width: 1024px)");
  const sync = () => { if (hmore && wide.matches) hmore.open = true; };
  sync();
  wide.addEventListener("change", sync);
</script>

<style>
  .lead { font-size: var(--fs-lead); line-height: 1.45; max-width: 40rem; }

  /* ---------- 1. hero ---------- */
  .hero__field { background: var(--color-lime); padding-top: clamp(32px, 1rem + 4vw, 72px); padding-bottom: var(--s-4); }
  h1 {
    font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 800; letter-spacing: -.02em;
    font-variation-settings: var(--sharp); text-wrap: balance;
  }
  @media (min-width: 768px) { .hero__h1-2 { display: block; } }
  .hero__row { display: grid; gap: var(--s-3); margin-top: var(--s-3); }
  .hero__lead { font-size: var(--fs-lead); line-height: 1.45; max-width: 34rem; }
  .hero__actions { display: grid; gap: var(--s-1); align-content: start; }
  .hero__links { display: flex; flex-wrap: wrap; column-gap: var(--s-3); }
  @media (min-width: 1280px) { .hero__links a { white-space: nowrap; } }

  .talk { position: relative; }
  .talk__btn { list-style: none; width: 100%; }
  .talk__btn::-webkit-details-marker { display: none; }
  .talk__plus { transition: transform var(--dur-fast) var(--ease-out); }
  .talk[open] .talk__plus { transform: rotate(45deg); }
  .talk__list { list-style: none; margin: var(--s-1) 0 0; padding: 0; display: grid; gap: var(--s-1); }
  .talk__list .btn { width: 100%; }
  .talk[open] .talk__list { animation: drop var(--dur-fast) var(--ease-out); }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } }

  .hero__stage { background: linear-gradient(var(--color-lime) 0 33%, var(--color-bg) 33% 100%); }
  .hero__photo { position: relative; margin: 0; }
  .hero__photo :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 60%; background: var(--color-gray); }
  .plate {
    position: absolute; left: 0; bottom: 0; background: var(--color-lime); color: var(--color-graphite);
    padding: 12px 16px 16px; display: grid; gap: 4px;
  }
  .plate__code { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h3); line-height: var(--lh-h3); }
  .plate__meta { font-size: var(--fs-body); }

  /* motion 1: the dim rises from the plot line, then the code plate slides in */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero__photo :global(img) { animation: rise var(--dur-photo) var(--ease-out) both; }
    :global(.js) .plate { animation: plate 300ms var(--ease-out) var(--dur-photo) both; }
  }
  @keyframes rise { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes plate { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  @media (min-width: 768px) {
    .hero__row { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--gutter); align-items: start; }
    .hero__actions { grid-column: 2; justify-items: start; }
    .talk__btn { width: auto; }
    .talk__list { position: absolute; left: 0; top: 100%; z-index: 5; min-width: 100%; background: var(--color-lime); padding-top: var(--s-1); }
    .hero__photo :global(img) { aspect-ratio: 16 / 7; }
    .plate { padding: 16px 24px 20px; }
  }
  @media (min-width: 1024px) {
    .hero__row { grid-template-columns: minmax(0, 5fr) minmax(0, 1fr) minmax(0, 6fr); }
    .hero__actions { grid-column: 3; }
  }
