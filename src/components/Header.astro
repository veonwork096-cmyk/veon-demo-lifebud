---
import { Image } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import logoLight from "../assets/img/logo-light.png";
import logoMob from "../assets/img/logo-mob.png";
import { TEL, PHONE_SHOWN, VIBER, TELEGRAM, SOON } from "../data/site";

const anchors = [
  { href: "#projects", label: "Проєкти" },
  { href: "#build", label: "Будівництво і ціни" },
  { href: "#houses", label: "КМ «Сонячний»" },
  { href: "#about", label: "Про компанію" },
  { href: "#contacts", label: "Контакти" },
];
const future = ["Оренда спецтехніки", "Блог"];
---
<header class="site-header on-dark">
  <div class="container header__in">
    <a class="logo" href="#top" aria-label="Лайфбуд, на початок сторінки">
      <Image class="logo__wide" src={logoLight} alt="" width={200} height={72} loading="eager" data-rec="R-004" />
      <Image class="logo__tile" src={logoMob} alt="" width={107} height={72} loading="eager" data-rec="R-004" />
    </a>

    <nav class="nav-desktop" aria-label="Головне меню">
      <ul>
        {anchors.map((a) => <li><a href={a.href}>{a.label}</a></li>)}
        {future.map((f) => <li><FutureLink note={SOON} class="fl-nav">{f}</FutureLink></li>)}
      </ul>
    </nav>

    <div class="header__contact">
      <a class="header__phone" href={TEL}>{PHONE_SHOWN}</a>
      <a class="header__icon" href={VIBER} aria-label="Написати у Viber"><Icon name="viber" /></a>
      <a class="header__icon" href={TELEGRAM} aria-label="Написати в Telegram"><Icon name="telegram" /></a>
    </div>

    <details class="menu" data-rec="R-008">
      <summary class="menu__btn"><span class="menu__open">Меню</span><span class="menu__close">Закрити</span></summary>
      <div class="menu__panel">
        <nav aria-label="Меню сайту">
          <ul class="menu__list">
            {anchors.map((a) => <li><a href={a.href}>{a.label}</a></li>)}
            {future.map((f) => <li><FutureLink note={SOON} class="fl-menu">{f}</FutureLink></li>)}
          </ul>
        </nav>
        <ul class="menu__channels">
          <li><a class="btn btn--accent" href={TEL}><Icon name="phone" />Подзвонити</a></li>
          <li><a class="btn btn--ghost-dark" href={VIBER}><Icon name="viber" />Viber</a></li>
          <li><a class="btn btn--ghost-dark" href={TELEGRAM}><Icon name="telegram" />Telegram</a></li>
        </ul>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the menu after choosing a section (the menu itself works without scripts: <details>).
  const menu = document.querySelector<HTMLDetailsElement>(".menu");
  if (menu) {
    menu.querySelectorAll("a[href^='#']").forEach((a) => a.addEventListener("click", () => { menu.open = false; }));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) { menu.open = false; menu.querySelector("summary")?.focus(); }
    });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--color-graphite); color: var(--color-white);
    height: var(--header-h);
  }
  .header__in { height: 100%; display: flex; align-items: center; gap: var(--s-2); }
  .logo { display: flex; align-items: center; height: 100%; flex: none; padding-block: 8px; }
  .logo :global(img) { height: 100%; width: auto; }
  .logo__wide { display: none; }
  .nav-desktop { display: none; }

  .header__contact { margin-left: auto; display: flex; align-items: center; gap: var(--s-1); }
  .header__phone {
    font-family: var(--font-display); font-weight: 700; font-size: .9375rem; white-space: nowrap;
    text-decoration: none; min-height: var(--tap); display: inline-flex; align-items: center; padding-inline: 4px;
  }
  .header__phone:hover { color: var(--color-accent); }
  .header__icon {
    display: none; width: var(--tap); height: var(--tap); align-items: center; justify-content: center;
    border-radius: var(--radius); color: var(--color-white); transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .header__icon:hover { color: var(--color-accent); background: var(--color-plate); }

  .menu { flex: none; }
  .menu__btn {
    list-style: none; cursor: pointer; min-height: var(--tap); min-width: var(--tap); padding: 0 16px;
    display: inline-flex; align-items: center; justify-content: center;
    border: var(--line) solid var(--color-white); border-radius: var(--radius);
    font-weight: 600; font-size: 1rem; user-select: none;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .menu__btn::-webkit-details-marker { display: none; }
  .menu__btn:hover { background: var(--color-white); color: var(--color-graphite); }
  .menu__close { display: none; }
  .menu[open] .menu__open { display: none; }
  .menu[open] .menu__close { display: inline; }
  .menu__panel {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--color-graphite); border-top: 1px solid var(--color-plate);
    padding: var(--s-3) var(--space) var(--s-4);
    max-height: calc(100dvh - var(--header-h)); overflow-y: auto;
  }
  .menu__list, .menu__channels { list-style: none; margin: 0; padding: 0; }
  .menu__list a, .menu__list :global(.future-link) {
    display: flex; align-items: center; min-height: 48px; font-size: 1.25rem; font-weight: 600; text-decoration: none; white-space: nowrap;
    border-bottom: 1px solid var(--color-plate);
  }
  .menu__list :global(.future-link) { color: var(--color-muted-dark); font-weight: 400; }
  .menu__list a:hover { color: var(--color-accent); }
  .menu__channels { display: grid; gap: var(--s-1); margin-top: var(--s-3); }
  .menu__channels .btn { width: 100%; }

  @media (max-width: 359px) {
    .header__in { gap: var(--s-1); }
    .header__phone { font-size: .8125rem; padding-inline: 0; }
    .menu__btn { padding: 0 8px; }
  }
  @media (min-width: 768px) {
    .logo { padding-block: 8px; }
    .logo__wide { display: block; }
    .logo__tile { display: none; }
    .header__phone { font-size: 1.125rem; }
    .header__icon { display: inline-flex; }
    .menu__channels { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1380px) {
    .header__in { gap: var(--s-3); }
    .nav-desktop { display: block; }
    .nav-desktop ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 2px; }
    .nav-desktop a, .nav-desktop :global(.future-link) {
      display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 8px;
      font-weight: 600; font-size: .9375rem; text-decoration: none; white-space: nowrap;
      border-radius: var(--radius);
      transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
    }
    .nav-desktop a:hover { color: var(--color-accent); background: var(--color-plate); }
    .nav-desktop :global(.future-link) { color: var(--color-muted-dark); font-weight: 400; }
    .header__contact { gap: 2px; }
    .menu { display: none; }
  }
</style>
